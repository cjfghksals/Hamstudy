{
  "name": "hamsterdy",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "server": "node server.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.hamstudy.app",
    "productName": "햄스터디",
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "image/icon.ico",
      "artifactName": "Hamstudy-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "image/icon.ico",
      "uninstallerIcon": "image/icon.ico",
      "shortcutName": "햄스터디",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "image/**/*",
      "image/icon.ico"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
